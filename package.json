{
  "name": "autotesting-js",
  "version": "1.0.0",
  "type": "module",
  "description": "autotesting",
  "main": "src/index.js",
  "scripts": {
    "test": "mocha 'test/**/*.test.js' --reporter json > test-results.json && node scripts/generate-html-report.js",
    "test:html": "mocha 'test/**/*.test.js' --reporter json > test-results.json && node scripts/generate-html-report.js",
    "test:watch": "mocha 'test/**/*.test.js' --watch",
    "coverage": "c8 --reporter=html --reporter=text mocha 'test/**/*.test.js'",
    "coverage:check": "c8 --reporter=text --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 mocha 'test/**/*.test.js'",
    "lint": "eslint src/**/*.js test/**/*.js",
    "lint:fix": "eslint src/**/*.js test/**/*.js --fix",
    "build": "babel src -d dist",
    "precommit": "npm run lint && npm run test && npm run coverage:check",
    "setup": "node scripts/setup-husky.js",
    "postinstall": "npm run setup"
  },
  "keywords": [
    "testing",
    "mocha",
    "chai",
    "coverage",
    "eslint",
    "babel"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/register": "^7.22.0",
    "@eslint/js": "^9.37.0",
    "c8": "^8.0.1",
    "chai": "^4.3.10",
    "eslint": "^8.57.1",
    "globals": "^16.4.0",
    "husky": "^8.0.3",
    "mocha": "^10.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
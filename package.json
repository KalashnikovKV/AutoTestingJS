{
  "name": "autotesting-js",
  "version": "1.0.0",
  "description": "Automated testing project using Playwright for demoqa.com",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chrome",
    "test:firefox": "playwright test --project=firefox",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "install:browsers": "playwright install"
  },
  "keywords": ["playwright", "testing", "automation", "demoqa"],
  "author": "AutoTesting Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint-plugin-playwright": "^0.19.0",
    "@faker-js/faker": "^8.4.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
